FROM anujdatar/cups

RUN apt-get update && \
    apt-get remove -y hplip hplip-data && \
    apt-get install -y \
        printer-driver-foo2zjs \
        ghostscript \
        cups-filters \
        poppler-utils && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/share/foo2zjs/firmware && \
    cd /usr/share/foo2zjs/firmware && \
    getweb 1020
